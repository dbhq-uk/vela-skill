<?xml version="1.0" encoding="utf-8"?>
<!--
  vela hosts its own Roslyn, and Roslyn refuses to load a source generator that was
  built against a NEWER compiler than the host. The Razor generator is not vela's to
  choose: it comes out of whichever .NET SDK evaluates the project, so the SDK sets a
  floor on the Roslyn vela must host. SDK 10.0.400 ships Microsoft.CodeAnalysis
  5.9.0-1.26379.115, and nuget.org has not published a 5.9 yet - 5.6.0 is the newest
  stable there. Until it does, the only build of 5.9 that exists is the one the SDK
  itself was assembled from, on the .NET team's own feed, which is what this adds.

  Remove this file and move the Microsoft.CodeAnalysis.* references back to a plain
  version the moment 5.9.0 or later is on nuget.org. See docs/upstream/razor-sdk-10-0-400.md.

  clear comes first so a machine-wide or user-level NuGet.config cannot quietly add a
  source vela did not ask for.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="dotnet-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- The .NET team's feed is here for exactly three packages. Everything else must
         come from nuget.org, so a compromised or merely surprising build on that feed
         cannot substitute itself for a dependency vela expects from nuget.org. -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-tools">
      <package pattern="Microsoft.CodeAnalysis.CSharp.Workspaces" />
      <package pattern="Microsoft.CodeAnalysis.VisualBasic.Workspaces" />
      <package pattern="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
      <package pattern="Microsoft.CodeAnalysis.Common" />
      <package pattern="Microsoft.CodeAnalysis.CSharp" />
      <package pattern="Microsoft.CodeAnalysis.VisualBasic" />
      <package pattern="Microsoft.CodeAnalysis.Workspaces.Common" />
      <package pattern="Microsoft.CodeAnalysis.Analyzers" />
      <package pattern="Microsoft.CodeAnalysis.Elfie" />
    </packageSource>
  </packageSourceMapping>
</configuration>
