<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vela</ToolCommandName>
    <PackageId>vela</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="5.6.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />

    <!-- GHSA-2m69-gcr7-jv3q: the bundled SQLite native library is vulnerable at
         <= 2.1.11, and the newest Microsoft.Data.Sqlite (10.0.10) still resolves
         2.1.11, so the fix has to come from a direct reference. Pinning the bundle
         rather than lib.e_sqlite3 alone keeps the native binary, the provider and
         core on one version instead of mixing 2.1.12 native with 2.1.11 managed.
         Drop this once a stable Microsoft.Data.Sqlite resolves 2.1.12 or later. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />

    <!-- MSBL001: MSBuildLocator requires these to be compile-time only, and
         NU1605: the versions must match what Workspaces.MSBuild 5.6.0 resolves. -->
    <PackageReference Include="Microsoft.Build" Version="17.11.48"
                      ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48"
                      ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.11.48"
                      ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Tools" Version="2.71.0" PrivateAssets="all" />
    <Protobuf Include="Scip/scip.proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <!-- So the suite can drive Program.PlanRebuildAsync directly. The behaviour that
         needs it is the fallback catch declining to swallow a cancellation, which no
         route through the CLI can reach on its own. -->
    <InternalsVisibleTo Include="Vela.Tests" />
  </ItemGroup>
</Project>
