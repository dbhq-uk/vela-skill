<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vela</ToolCommandName>
    <PackageId>vela</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />

    <!-- The Razor source generator is not a package vela references: it is a DLL inside
         whichever .NET SDK evaluates the project, and Roslyn refuses to load a generator
         built against a compiler newer than the host, silently, with zero generators
         returned. SDK 10.0.400's Razor compiler references Microsoft.CodeAnalysis
         5.9.0.0; at 5.6.0 vela loaded no Razor generator at all and indexed zero .cshtml
         and zero .razor. So this version is a FLOOR set by the SDK, not a preference:
         it must be at least the Roslyn the newest SDK in use ships.

         Prerelease because nuget.org's newest stable Microsoft.CodeAnalysis is 5.6.0.
         This exact build, 5.9.0-1.26379.115, is the one SDK 10.0.400 itself was
         assembled from. See NuGet.config and docs/upstream/razor-sdk-10-0-400.md.
         RazorGeneratorTests is the guard: it fails loudly if this drifts behind again. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0-1.26467.109" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0-1.26467.109" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="5.9.0-1.26467.109" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />

    <!-- The direct SQLitePCLRaw.bundle_e_sqlite3 pin that used to sit here is GONE,
         18 Sep 2026, and its own comment said when to drop it: it was here because
         GHSA-2m69-gcr7-jv3q makes the bundled SQLite native library vulnerable at
         2.1.11 and below, and Microsoft.Data.Sqlite 10.0.10 still resolved 2.1.11.
         10.0.12 resolves 2.1.12 on its own - verified by listing the transitive
         packages with the pin removed, all four SQLitePCLRaw packages at 2.1.12.
         A pin that no longer raises anything is not protection, it is a
         second place the version is stated. If a future Microsoft.Data.Sqlite ever
         resolves below 2.1.12, put it back. -->

    <!-- MSBL001: MSBuildLocator requires these to be compile-time only, and
         NU1605: the versions must match what Workspaces.MSBuild resolves.
         THE VERSION IS NOT A PREFERENCE AND MUST NOT BE BUMPED ALONE. Dependabot
         proposed 18.10.1 for Framework and Utilities.Core on 17 Sep 2026 and left
         Microsoft.Build at 17.11.48, which broke the build on all three platforms:
         Framework 18.10.1 drags Microsoft.NET.StringTools 18.10.1 in as a
         PackageReference without ExcludeAssets="runtime", which is precisely what
         MSBL001 refuses. The trio is ignored in .github/dependabot.yml for that
         reason; it moves when Workspaces.MSBuild moves, together, by hand. -->
    <PackageReference Include="Microsoft.Build" Version="17.11.48"
                      ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48"
                      ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.11.48"
                      ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="all" />
    <Protobuf Include="Scip/scip.proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <!-- So the suite can drive Program.PlanRebuildAsync directly. The behaviour that
         needs it is the fallback catch declining to swallow a cancellation, which no
         route through the CLI can reach on its own. -->
    <InternalsVisibleTo Include="Vela.Tests" />
  </ItemGroup>
</Project>
